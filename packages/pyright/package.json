{
    "name": "pyright",
    "displayName": "Pyright",
    "description": "Type checker for the Python language",
    "version": "1.1.414",
    "license": "MIT",
    "author": {
        "name": "Microsoft Corporation"
    },
    "publisher": "Microsoft Corporation",
    "engines": {
        "node": ">=14.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Microsoft/pyright",
        "directory": "packages/pyright"
    },
    "scripts": {
        "build": "rspack build -c rspack.config.js --mode production",
        "clean": "shx rm -rf ./dist ./out README.md LICENSE.txt",
        "prepack": "pnpm run clean && shx cp ../../README.md . && shx cp ../../LICENSE.txt . && pnpm run build",
        "webpack": "rspack build -c rspack.config.js --mode development",
        "webpack:cli": "rspack build -c rspack.cli.config.js --mode production",
        "webpack:cli:dev": "rspack build -c rspack.cli.config.js --mode development",
        "bundle:cli:flat": "esbuild src/pyright.ts --bundle --platform=node --format=esm --target=node20 --external:fsevents --banner:js=\"import{createRequire}from'module';import{fileURLToPath}from'url';import{dirname}from'path';const require=createRequire(import.meta.url);const __dirname=dirname(fileURLToPath(import.meta.url));\" --outfile=dist-cli-dev/pyright-flat.js --alias:vscode-languageserver=../pyright-internal/src/scriptcCompat/vscodeLanguageserver.ts --alias:vscode-languageserver/node=../pyright-internal/src/scriptcCompat/vscodeLanguageserverNode.ts --alias:vscode-languageserver/browser=../pyright-internal/src/scriptcCompat/vscodeLanguageserverNode.ts --alias:vscode-languageserver-protocol=../pyright-internal/src/scriptcCompat/vscodeLanguageserverProtocol.ts --alias:vscode-jsonrpc=../pyright-internal/src/scriptcCompat/vscodeJsonrpc.ts --alias:vscode-jsonrpc/node=../pyright-internal/src/scriptcCompat/vscodeJsonrpc.ts --alias:vscode-jsonrpc/browser=../pyright-internal/src/scriptcCompat/vscodeJsonrpc.ts --alias:jsonc-parser=jsonc-parser/lib/esm/main.js --alias:chokidar=../pyright-internal/src/scriptcCompat/chokidar.ts --alias:source-map-support=../pyright-internal/src/scriptcCompat/sourceMapSupport.ts --tsconfig=tsconfig.json"
    },
    "optionalDependencies": {
        "fsevents": "~2.3.3"
    },
    "devDependencies": {
        "@rspack/cli": "^2.2.2",
        "@rspack/core": "^2.2.2",
        "@types/node": "^25.9.2",
        "copy-webpack-plugin": "^14.0.0",
        "esbuild": "0.28.1",
        "esbuild-loader": "^4.5.0",
        "shx": "^0.4.0",
        "ts-loader": "^9.5.4",
        "typescript": "~6.0.3",
        "webpack": "^5.104.1"
    },
    "files": [
        "/dist",
        "LICENSE.txt"
    ],
    "main": "index.js",
    "bin": {
        "pyright": "index.js",
        "pyright-langserver": "langserver.index.js"
    }
}
